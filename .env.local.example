# Copy to .env.local — this is the single source of truth for local dev and cloud-agent ops.
# See AGENTS.md for how to use the same file in Cursor Cloud Agents.

# --- Supabase (app + scripts) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Supabase CLI (migrations + ad-hoc SQL via `npm run ops:db:*`) ---
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# Project ref from Dashboard → Settings → General (20-char string)
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
# Database password from Dashboard → Settings → Database
SUPABASE_DB_PASSWORD=your-db-password

# Optional: direct Postgres URL for psql (Dashboard → Connect → URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Vercel (production deploy via `npm run ops:deploy:prod`) ---
# Token: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Team slug or user ID + project ID from .vercel/project.json after `vercel link`
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Feature flags (match production Vercel env) ---
GROUP_SCOPING_ENABLED=true
GROUP_PREDICTION_ENABLED=true
GROUP_RUMMY_ENABLED=true
WORLD_CUP_IMPORT_ENABLED=true
WORLD_CUP_PRIVATE_MODE=true
WORLD_CUP_ODD_BONUS_ENABLED=true

# --- World Cup pilot (optional) ---
# DEFAULT_GROUP_ID=
# DEFAULT_CONTEST_ID=
# DEFAULT_INVITE_CODE=
